  "scale_rule": [
    {
      "difference": "Attacker is 2+ sizes larger",
      "result": "Target is destroyed or removed from play. No roll needed if it cannot escape."
    },
    {
      "difference": "Attacker is 1 size larger",
      "result": "Double the overage. Armor still applies."
    },
    {
      "difference": "Same size",
      "result": "Normal overage."
    },
    {
      "difference": "Attacker is 1 size smaller",
      "result": "Half the overage, rounded down. Armor applies first."
    },
    {
      "difference": "Attacker is 2+ sizes smaller",
      "result": "No effect: a rifle does not hurt a tank. Needs a Scale-Breaking weapon."
    }
